{
  "name": "muzlo",
  "version": "0.1.0",
  "private": true,
  "description": "«Чьё музло?!» — локальная party-игра: комната запускается на одном устройстве, гости подключаются по ссылке",
  "workspaces": [
    "shared",
    "app",
    "server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:shared": "npm run build -w @muzlo/shared",
    "build": "npm run build -w app",
    "host": "npm run build && node server/index.mjs",
    "host:tunnel": "npm run build && node server/index.mjs --tunnel",
    "dev": "npm run dev -w app",
    "preview": "npm run preview -w app"
  }
}
